# .htaccess
<IfModule mod_rewrite.c>
    # 1. Activa el motor de reescritura de URLs de Apache.
    RewriteEngine On

    # 2. Condición: NO es un archivo real. (Permite cargar /assets/css, /assets/js, etc.)
    RewriteCond %{REQUEST_FILENAME} !-f

    # 3. Condición: NO es un directorio real.
    RewriteCond %{REQUEST_FILENAME} !-d

    # 4. Regla: Redirige cualquier otra solicitud (^) a index.php.
    # [QSA] Query String Append: Muy importante, conserva los parámetros GET (?id=MAC&ap=AP_MAC) que envía UniFi.
    # [L] Last: Termina de procesar las reglas aquí.
    RewriteRule ^ index.php [QSA,L]
</IfModule>